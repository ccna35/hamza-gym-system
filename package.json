{
  "name": "hamza-gym-system",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @gym/api --filter @gym/web dev",
    "build": "corepack pnpm --recursive --if-present build",
    "lint": "corepack pnpm --recursive --if-present lint",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,html}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,mjs,yaml,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,css,html}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,mjs,yaml,yml}\"",
    "format-check": "prettier --check \"apps/**/*.{ts,tsx,js,json,css,html}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,mjs,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
