generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(100)
  passwordHash       String    @db.Text
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  auditLogs          AuditLog[]
}

enum AuditEntityType {
  MEMBER
  PLAN
  SUBSCRIPTION
  PAYMENT
}

enum AuditAction {
  MEMBER_CREATED
  MEMBER_UPDATED
  MEMBER_ARCHIVED
  MEMBER_RESTORED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ENABLED
  PLAN_DISABLED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_VOIDED
  PAYMENT_CREATED
  PAYMENT_VOIDED
}

model AuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  actorOwnerId String          @db.Uuid
  entityType   AuditEntityType
  entityId     String          @db.VarChar(255)
  action       AuditAction
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  requestId    String?         @db.VarChar(255)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  actorOwner   Owner           @relation(fields: [actorOwnerId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorOwnerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @db.Uuid
  sessionTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime? @db.Timestamptz(3)
  owner            Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
}

enum MemberGender {
  MALE
  FEMALE
}

model Member {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(200)
  phoneDisplay    String       @db.VarChar(20)
  phoneNormalized String       @unique @db.VarChar(11)
  gender          MemberGender
  dateOfBirth     DateTime     @db.Date
  photoKey        String?      @db.VarChar(255)
  heightCm        Decimal?     @db.Decimal(5, 2)
  weightKg        Decimal?     @db.Decimal(6, 2)
  joinDate        DateTime     @db.Date
  isArchived      Boolean      @default(false)
  archivedAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  subscriptions   Subscription[]
  payments        Payment[]

  @@index([isArchived, name])
  @@index([joinDate])
}

enum PaymentMethod {
  CASH
}

model Payment {
  id                       String        @id @default(uuid()) @db.Uuid
  memberId                 String        @db.Uuid
  amountMinor              BigInt
  balanceAfterPaymentMinor BigInt
  paymentDate              DateTime      @db.Date
  paymentMethod            PaymentMethod @default(CASH)
  receiptNumber            String        @unique @db.VarChar(32)
  verificationToken        String        @unique @db.VarChar(32)
  voidedAt                 DateTime?      @db.Timestamptz(3)
  voidReason               String?       @db.Text
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  member                   Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId, paymentDate(sort: Desc), createdAt(sort: Desc)])
  @@index([paymentDate])
}

model SystemCounter {
  key       String   @id @db.VarChar(64)
  nextValue BigInt
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Plan {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(100)
  isEnabled Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  prices    PlanPrice[]
  subscriptions Subscription[]

  @@index([isEnabled])
}

model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  memberId          String   @db.Uuid
  planId            String   @db.Uuid
  planNameSnapshot  String   @db.VarChar(100)
  durationMonths    Int      @db.SmallInt
  listedPriceMinor  BigInt
  agreedPriceMinor  BigInt
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  voidedAt          DateTime? @db.Timestamptz(3)
  voidReason        String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([memberId, startDate(sort: Desc)])
  @@index([startDate])
  @@index([endDate])
}

model PlanPrice {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @db.Uuid
  durationMonths Int      @db.SmallInt
  priceMinor     BigInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, durationMonths])
}
