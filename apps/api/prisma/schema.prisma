generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(100)
  passwordHash       String    @db.Text
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  auditLogs          AuditLog[]
}

enum AuditEntityType {
  MEMBER
  PLAN
  SUBSCRIPTION
  PAYMENT
}

enum AuditAction {
  MEMBER_CREATED
  MEMBER_UPDATED
  MEMBER_ARCHIVED
  MEMBER_RESTORED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ENABLED
  PLAN_DISABLED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_VOIDED
  PAYMENT_CREATED
  PAYMENT_VOIDED
}

model AuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  actorOwnerId String          @db.Uuid
  entityType   AuditEntityType
  entityId     String          @db.VarChar(255)
  action       AuditAction
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  requestId    String?         @db.VarChar(255)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  actorOwner   Owner           @relation(fields: [actorOwnerId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorOwnerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @db.Uuid
  sessionTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime? @db.Timestamptz(3)
  owner            Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
}

enum MemberGender {
  MALE
  FEMALE
}

model Member {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(200)
  phoneDisplay    String       @db.VarChar(20)
  phoneNormalized String       @unique @db.VarChar(11)
  gender          MemberGender
  dateOfBirth     DateTime     @db.Date
  photoKey        String?      @db.VarChar(255)
  heightCm        Decimal?     @db.Decimal(5, 2)
  weightKg        Decimal?     @db.Decimal(6, 2)
  joinDate        DateTime     @db.Date
  isArchived      Boolean      @default(false)
  archivedAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  @@index([isArchived, name])
  @@index([joinDate])
}

model Plan {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(100)
  isEnabled Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  prices    PlanPrice[]

  @@index([isEnabled])
}

model PlanPrice {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @db.Uuid
  durationMonths Int      @db.SmallInt
  priceMinor     BigInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, durationMonths])
}
